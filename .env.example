DRY_RUN=true
USE_MOCK_DATA=true
DATA_PROVIDER=yfinance
ENABLE_LLM_BRANCH=false
ENABLE_OPENAI=false
ENABLE_CLAUDE=false
ENABLE_PAID_DATA=false
ENABLE_ALPACA=false
ALPACA_ENV=paper
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_DATA_FEED=iex
YFINANCE_LOOKBACK_DAYS=756
YFINANCE_INTERVAL=1d
YFINANCE_AUTO_ADJUST=true
YFINANCE_PROGRESS=false
AKSHARE_LOOKBACK_DAYS=12000
AKSHARE_HK_ENDPOINT=daily
AKSHARE_A_SHARE_ENDPOINT=auto
AKSHARE_MAX_WORKERS=8
AKSHARE_A_SHARE_MAX_WORKERS=4
AKSHARE_RETRY_ATTEMPTS=3
AKSHARE_RETRY_BACKOFF_SECONDS=0.5
OPENBB_ENABLED=false
OPENBB_PROVIDER=yfinance
OPENFIGI_API_KEY=
# Backward-compatible alias; set only one OpenFIGI variable locally.
OPEN_FIGI_API_KEY=

# Multi-source market and economic data. Add credentials locally in .env only.
USE_ALL_AVAILABLE_DATA_SOURCES=true
DATA_PRICE_PROVIDERS=eodhd,finnhub,yfinance,akshare,openbb,tickdb,alpaca,itick
DATA_CROSS_VALIDATE_PRICES=true
DATA_REQUEST_TIMEOUT_SECONDS=30
DATA_RETRY_ATTEMPTS=3

# Optional entitled Bloomberg Desktop API. No API key is used.
BLOOMBERG_DESKTOP_ENABLED=
BLOOMBERG_HOST=127.0.0.1
BLOOMBERG_PORT=8194
BLOOMBERG_TIMEOUT_SECONDS=30
BLOOMBERG_LOOKBACK_DAYS=10950
BLOOMBERG_MAX_SECURITIES_PER_REQUEST=10

# Explicit development/CI smoke mode. Keep false for production DRL evaluation.
DRL_MOCK_MODE=false

EODHD_API_TOKEN=
EODHD_BASE_URL=https://eodhd.com/api

# Point-in-time filing and historical fundamental evidence.
BEAM_API_KEY=
BEAM_SEC_METADATA_URL=https://api.beamapi.com/data/fundamentals/us/sec/metadata/v1/
SEC_USER_AGENT=
NASDAQ_DATA_LINK_API_KEY=
NASDAQ_DATA_LINK_BASE_URL=https://data.nasdaq.com/api/v3

FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

FRED_API_KEY=
FRED_BASE_URL=https://api.stlouisfed.org/fred

TICKDB_API_KEY=
TICKDB_BASE_URL=https://api.tickdb.ai

ITICK_API_TOKEN=
ITICK_BASE_URL=https://api.itick.org

FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
ECB_DATA_BASE_URL=https://data-api.ecb.europa.eu/service
ONS_API_BASE_URL=https://api.beta.ons.gov.uk/v1
BANK_OF_ENGLAND_BASE_URL=https://www.bankofengland.co.uk/boeapps/database/_iadb-fromshowcolumns.asp
CHINA_DATA_BASE_URL=https://chinadata.live/api/v2
HKMA_API_BASE_URL=https://api.hkma.gov.hk/public
